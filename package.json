{
  "name": "renor-engine",
  "version": "1.4.6",
  "description": "Local-first semantic memory — indexing, multi-signal retrieval, MCP",
  "main": "dist/cli.js",
  "files": [
    "bin",
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsc && node -e \"require('node:fs').copyFileSync('src/memory/hiveNameHeader.cjs', 'dist/memory/hiveNameHeader.cjs')\"",
    "test": "vitest run",
    "test:pack": "vitest run --config vitest.pack.config.ts",
    "test:watch": "vitest",
    "dev": "tsx src/cli.ts",
    "mvp": "node dist/mvp/cli.js",
    "mvp:dev": "tsx src/mvp/cli.ts",
    "import:memory": "tsx src/importing/cli.ts",
    "pack:npm": "npm run build && node scripts/npm/pack.mjs",
    "test:mvp-artifact": "node scripts/ci/verify-mvp-artifact.mjs",
    "eval:typecheck": "tsc -p tsconfig.public-eval.json",
    "eval:retrieval": "tsx -r ./scripts/lib/no-sharing-preload.cjs scripts/eval/score-retrieval.ts",
    "eval:renor": "tsx -r ./scripts/lib/no-sharing-preload.cjs scripts/eval/run-renorbench.ts",
    "eval:renor:hash": "tsx -r ./scripts/lib/no-sharing-preload.cjs scripts/eval/run-renorbench.ts --provider hash",
    "eval:renor:product": "tsx -r ./scripts/lib/no-sharing-preload.cjs scripts/eval/run-renorbench-product.ts --top-k 20",
    "eval:renor:product:hash": "tsx -r ./scripts/lib/no-sharing-preload.cjs scripts/eval/run-renorbench-product.ts --provider hash --top-k 20",
    "eval:renor:product:v2:hash": "tsx -r ./scripts/lib/no-sharing-preload.cjs scripts/eval/run-renorbench-product.ts --provider hash --suite v2 --top-k 20",
    "eval:renor:default-arm": "node -r ./scripts/lib/no-sharing-preload.cjs scripts/eval/report-default-arm.mjs",
    "eval:renor:product:docs:hash": "tsx -r ./scripts/lib/no-sharing-preload.cjs scripts/eval/run-renorbench-product.ts --provider hash --suite documents --top-k 20",
    "eval:cache": "tsx -r ./scripts/lib/no-sharing-preload.cjs scripts/eval/eval-cache.ts",
    "eval:compare": "tsx -r ./scripts/lib/no-sharing-preload.cjs scripts/eval/compare-runs.ts",
    "eval:renorbench:baseline": "tsx -r ./scripts/lib/no-sharing-preload.cjs scripts/eval/renorbench-baseline.ts",
    "eval:renor:v2:generate": "tsx -r ./scripts/lib/no-sharing-preload.cjs scripts/eval/generate-renorbench-v2.ts --write",
    "eval:renor:docs:generate": "tsx -r ./scripts/lib/no-sharing-preload.cjs scripts/eval/generate-renorbench-docs.ts --write",
    "eval:analyze": "tsx -r ./scripts/lib/no-sharing-preload.cjs scripts/eval/analyze-failures.ts",
    "eval:longmem": "tsx -r ./scripts/lib/no-sharing-preload.cjs scripts/eval/run-longmemeval.ts",
    "eval:longmem:merge": "tsx -r ./scripts/lib/no-sharing-preload.cjs scripts/eval/merge-longmemeval-shards.ts",
    "eval:longmem:qa": "tsx -r ./scripts/lib/no-sharing-preload.cjs scripts/eval/run-longmemeval-qa.ts",
    "eval:longmem:qa:score": "tsx -r ./scripts/lib/no-sharing-preload.cjs scripts/eval/score-longmemeval-qa.ts",
    "eval:longmem:product": "tsx -r ./scripts/lib/no-sharing-preload.cjs scripts/eval/run-longmemeval-product.ts",
    "eval:longmem:sessions": "tsx -r ./scripts/lib/no-sharing-preload.cjs scripts/eval/score-longmemeval-sessions.ts",
    "eval:longmem:v2": "tsx -r ./scripts/lib/no-sharing-preload.cjs scripts/eval/run-longmemeval-v2.ts",
    "eval:longmem:v2:score": "tsx -r ./scripts/lib/no-sharing-preload.cjs scripts/eval/score-longmemeval-v2.ts",
    "eval:locomo": "tsx -r ./scripts/lib/no-sharing-preload.cjs scripts/eval/locomo/run-retrieval.ts",
    "eval:locomo:score": "python3 scripts/eval/locomo/score-locomo.py",
    "eval:beam": "tsx -r ./scripts/lib/no-sharing-preload.cjs scripts/eval/beam/run-retrieval.ts",
    "eval:beam:score": "tsx -r ./scripts/lib/no-sharing-preload.cjs scripts/eval/beam/score-nuggets.ts",
    "eval:register": "tsx -r ./scripts/lib/no-sharing-preload.cjs scripts/eval/register-run.ts",
    "eval:progress": "tsx -r ./scripts/lib/no-sharing-preload.cjs scripts/eval/progress.ts",
    "prebuild": "node scripts/ci/stamp-build.mjs",
    "prepack": "npm run build"
  },
  "bin": {
    "renor-engine": "bin/renor-engine.cjs"
  },
  "keywords": [
    "renor",
    "semantic-memory",
    "mcp",
    "embeddings",
    "knowledge-graph"
  ],
  "homepage": "https://renor.cloud",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/renorai/renor-engine.git"
  },
  "bugs": {
    "url": "https://github.com/renorai/renor-engine/issues"
  },
  "author": "Patrick Passos",
  "license": "Apache-2.0",
  "type": "commonjs",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.31.0",
    "@posthog/mcp": "0.23.0",
    "@toon-format/toon": "4.4.0",
    "chokidar": "^4.0.3",
    "commander": "^14.0.3",
    "express": "^5.3.0",
    "gpt-tokenizer": "^3.4.0",
    "gray-matter": "^4.0.3",
    "openai": "^6.33.0",
    "posthog-node": "5.57.2",
    "sqlite-vec": "^0.1.8",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@xenova/transformers": "^2.17.2",
    "@types/express": "^5.0.6",
    "@types/node": "^25.9.9",
    "@types/supertest": "^7.2.0",
    "esbuild": "^0.28.2",
    "libpg-query": "17.7.4",
    "oxlint": "1.86.0",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.2",
    "vitest": "^4.1.12"
  },
  "peerDependencies": {
    "@xenova/transformers": "^2.17.2"
  },
  "peerDependenciesMeta": {
    "@xenova/transformers": {
      "optional": true
    }
  },
  "overrides": {
    "@xenova/transformers": {
      "sharp": "0.35.5",
      "onnxruntime-web": {
        "onnx-proto": {
          "protobufjs": "7.6.6"
        }
      }
    }
  },
  "engines": {
    "node": "^22.16.0 || >=24"
  }
}

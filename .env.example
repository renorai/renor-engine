# Copy to .env for local development
# Everything here is optional: with nothing set the command-line server keeps its notes in ~/.renor.
# docs/ENVIRONMENT-VARIABLES.md lists the settings a user may want; docs/ENVIRONMENT-VARIABLES-REFERENCE.md the rest.
# VAULT_PATH=/path/to/your/vault

# EMBEDDING_PROVIDER: none (the unset default) matches exact words and needs no key; openai needs OPENAI_API_KEY and sends
# note text to OpenAI; local downloads a model and runs it here; eval-hash is a deterministic stand-in for tests only
# (no quality claim, do not use it for real notes).
# EMBEDDING_PROVIDER=none
# openai: semantic embeddings via API; requires OPENAI_API_KEY.
# local: downloads and runs a model on this machine; no API key.
# EMBEDDING_MODEL=text-embedding-3-small
# HTTP server: MVP_EMBEDDING_PROVIDER=none disables embeddings for keyword-only smoke runs.
# OPENAI_API_KEY=sk-...
# DB_PATH=/path/to/your/vault/.semantic-memory/index.db
# MEMORY_DIR=Memory/Daily
# CONVERSATIONS_DIR=Claude Code/Conversations
# CHUNK_MAX_TOKENS=400
# CHUNK_OVERLAP_TOKENS=50
# PRIORITY_PATHS=Projects/,Areas/Work/
# LLM_EXTRACTION=false
# INDEX_CONCURRENCY=5
# Evidence pass: off unless set. always (every search) or auto (count/list questions) sends the query and up to 20
# matched notes (6,000 characters each) to RENOR_EVIDENCE_BASE_URL (default Ollama Cloud) with RENOR_EVIDENCE_API_KEY.
# RENOR_EVIDENCE_MODE=always


# Operators only. Optional production observability (metadata only; never memory/query content)
# Shared project API key (phc_…) for custom renor_* events AND @posthog/mcp Analytics.
# Do not commit real values. If unset / RENOR_TELEMETRY_DISABLED=true,
# MCP Analytics instrumentation is skipped (no crash).
# RENOR_POSTHOG_KEY=phc_...
# RENOR_POSTHOG_HOST=https://us.i.posthog.com
# RENOR_POSTHOG_CAPTURE_URL=https://us.i.posthog.com/i/v0/e/
# RENOR_SENTRY_DSN=https://PUBLIC_KEY@REGION.ingest.sentry.io/PROJECT_ID
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_HOST=https://cloud.langfuse.com
# RENOR_TELEMETRY_HASH_SALT=replace-with-random-deployment-secret
# RENOR_TELEMETRY_TIMEOUT_MS=1500
# RENOR_TELEMETRY_DISABLED=false
